{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/[^\\n\\r]*$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "registry",
    "profile"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-chem-v1-operator"
}
