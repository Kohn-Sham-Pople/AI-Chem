{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cluster_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "cluster_epoch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "approval": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reviewer",
        "approved_at",
        "note"
      ],
      "additionalProperties": false
    },
    "kind": {
      "const": "effective_execution"
    },
    "script_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "command_policy_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_env_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "defaults_reviewed": {
      "const": true
    },
    "local_precedence_pilot": {
      "const": true
    },
    "runtime_environment_equivalent": {
      "const": true
    },
    "approved_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "export_all_removed",
          "node_selection_removed",
          "queue_overridden",
          "name_overridden",
          "shell_overridden",
          "cwd_overridden",
          "rerun_overridden",
          "stdout_overridden",
          "join_overridden"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "evidence_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "cluster_id",
    "cluster_epoch",
    "owner",
    "approval",
    "kind",
    "script_sha256",
    "command_policy_sha256",
    "client_env_sha256",
    "defaults_reviewed",
    "local_precedence_pilot",
    "runtime_environment_equivalent",
    "approved_changes",
    "evidence_digest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
