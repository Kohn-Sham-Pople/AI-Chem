{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "calculation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "type": "string",
      "minLength": 1
    },
    "committed": {
      "type": "boolean"
    },
    "issue_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "minItems": 0
    },
    "request_digest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "bundle_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\n\\r]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "calculation_id",
    "stage_id",
    "result",
    "committed",
    "issue_codes",
    "request_digest",
    "bundle_path"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-chem-v1-result"
}
