{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "issuer_version": {
      "type": "string",
      "minLength": 1
    },
    "validation_status": {
      "const": "VALIDATED"
    },
    "producer_manifest_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "minLength": 1
    },
    "result_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 1
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ediff_pass": {
          "const": true
        },
        "rmsc_pass": {
          "const": true
        }
      },
      "required": [
        "id",
        "version",
        "ediff_pass",
        "rmsc_pass"
      ],
      "additionalProperties": false
    },
    "producer_ediff": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "shell_class": {
          "const": "f"
        },
        "calculation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "stage_id": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "s01_e4",
            "s02_e5"
          ]
        },
        "method_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "structure_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "potcar_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "u_set_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "lmaxmix": {
          "const": 6
        },
        "lcharg": {
          "const": true
        }
      },
      "required": [
        "shell_class",
        "calculation_id",
        "stage_id",
        "method_hash",
        "configuration_hash",
        "structure_sha256",
        "potcar_sha256",
        "u_set_id",
        "lmaxmix",
        "lcharg"
      ],
      "additionalProperties": false
    },
    "chgcar": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\n\\r]*$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "issuer",
    "issuer_version",
    "validation_status",
    "producer_manifest_sha256",
    "issued_at",
    "result_evidence_refs",
    "rule",
    "producer_ediff",
    "compatibility",
    "chgcar"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-chem-v1-evidence"
}
