{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "anyOf": [
            {
              "const": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "approval": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "reviewer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "approved_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "reviewer",
                "approved_at",
                "note"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "formula": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "species_blocks": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "block_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "element": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[A-Z][a-z]?$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "count": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "potential_variant": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "dataset_sha256": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "block_id",
                      "element",
                      "count",
                      "potential_variant",
                      "dataset_sha256"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "structures": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "structure_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sha256": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "structure_id",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "configurations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "configuration_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "structure_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "structure_sha256": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "spin_mode": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "enum": [
                              "collinear",
                              "noncollinear"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "soc": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "saxis": {
                        "anyOf": [
                          {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                                  "format": "canonical-decimal"
                                },
                                "minItems": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "magmom_by_atom": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "anyOf": [
                                    {
                                      "type": "object",
                                      "properties": {
                                        "atom_index": {
                                          "type": "integer",
                                          "minimum": 1
                                        },
                                        "moment": {
                                          "type": "string",
                                          "minLength": 1,
                                          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                                          "format": "canonical-decimal"
                                        }
                                      },
                                      "required": [
                                        "atom_index",
                                        "moment"
                                      ],
                                      "additionalProperties": false
                                    },
                                    {
                                      "type": "object",
                                      "properties": {
                                        "atom_index": {
                                          "type": "integer",
                                          "minimum": 1
                                        },
                                        "vector": {
                                          "type": "array",
                                          "items": {
                                            "type": "string",
                                            "minLength": 1,
                                            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                                            "format": "canonical-decimal"
                                          },
                                          "minItems": 1
                                        }
                                      },
                                      "required": [
                                        "atom_index",
                                        "vector"
                                      ],
                                      "additionalProperties": false
                                    }
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "minItems": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "configuration_id",
                      "structure_id",
                      "structure_sha256",
                      "spin_mode",
                      "soc",
                      "saxis",
                      "magmom_by_atom"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "u_sets": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "u_set_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "ldau": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "ldautype": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "by_block": {
                        "anyOf": [
                          {
                            "type": "object",
                            "additionalProperties": {
                              "type": "object",
                              "properties": {
                                "l": {
                                  "type": "integer",
                                  "minimum": -1,
                                  "maximum": 3
                                },
                                "u_eV": {
                                  "type": "string",
                                  "minLength": 1,
                                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                                  "format": "canonical-decimal"
                                },
                                "j_eV": {
                                  "type": "string",
                                  "minLength": 1,
                                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
                                  "format": "canonical-decimal"
                                }
                              },
                              "required": [
                                "l",
                                "u_eV",
                                "j_eV"
                              ],
                              "additionalProperties": false
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "u_set_id",
                      "ldau",
                      "ldautype",
                      "by_block"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "incar_tags": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "kpoints_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "potcar_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "approved_u_set_ids": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "minItems": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "incar_tags",
                "kpoints_sha256",
                "potcar_sha256",
                "approved_u_set_ids"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "approval",
        "formula",
        "species_blocks",
        "structures",
        "configurations",
        "u_sets",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "type": "null"
    }
  ]
}
