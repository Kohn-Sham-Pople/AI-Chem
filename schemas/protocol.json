{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "approved_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reviewer",
        "approved_at",
        "note"
      ],
      "additionalProperties": false
    },
    "shell_class": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "f",
        "d"
      ]
    },
    "recipe": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "open_f_v1",
        "open_d_v1"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "approval",
    "shell_class",
    "recipe"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-chem-v1-protocol"
}
