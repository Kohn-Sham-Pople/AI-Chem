{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "anyOf": [
            {
              "const": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "approval": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "reviewer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "approved_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "reviewer",
                "approved_at",
                "note"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "shell_class": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "enum": [
                "f",
                "d"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "recipe": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "enum": [
                "open_f_v1",
                "open_d_v1"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "approval",
        "shell_class",
        "recipe"
      ],
      "additionalProperties": false
    },
    {
      "type": "null"
    }
  ]
}
